{
  "name": "aplanner",
  "productName": "APlanner",
  "version": "1.0.0",
  "description": "Pianificazione della copertura WiFi su piante CAD (DXF/PDF) con access point MikroTik",
  "author": "Dario Giusti",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/",
  "scripts": {
    "build:web": "node build.js",
    "start": "npm run build:web && electron .",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:all": "npm run build:web && electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "it.belvedere.aplanner",
    "productName": "APlanner",
    "copyright": "Copyright © 2026",
    "publish": null,
    "files": [
      "electron/**/*",
      "dist/WiFiCoverage.html",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "icon": "build-resources/icon.png",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Utility",
      "maintainer": "Dario Giusti"
    }
  }
}
